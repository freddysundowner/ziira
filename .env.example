# Copy to .env and adjust.
ZIIRA_ENV=development
# Owner connection (migrations, admin commands)
ZIIRA_ADMIN_DATABASE_URL=postgresql+psycopg://ziira:ziira@localhost:5432/ziira
# Application connection (non-owner role; row-level security applies)
ZIIRA_APP_DATABASE_URL=postgresql+psycopg://ziira_app:ziira_app@localhost:5432/ziira
ZIIRA_APP_DB_ROLE=ziira_app
# Development only: tenant comes from the X-Tenant-ID header until authentication is built
ZIIRA_DEV_TENANT_HEADER=true
# Tests create and drop a database called ziira_test using this owner connection
ZIIRA_TEST_ADMIN_URL=postgresql+psycopg://ziira:ziira@localhost:5432/postgres
