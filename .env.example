# Copy to .env and adjust.
# Host port for the Docker PostgreSQL (change all 5432s below too if you change it)
ZIIRA_DB_PORT=5432
ZIIRA_ENV=development

# Master database: the list of tenants and how to reach each tenant's own database
ZIIRA_MASTER_DATABASE_URL=postgresql+psycopg://ziira:ziira@localhost:5432/ziira_master
# Server where each tenant's own database is created (a login allowed to create databases and roles)
ZIIRA_TENANT_SERVER_URL=postgresql+psycopg://ziira:ziira@localhost:5432/postgres

# Encrypts tenant database credentials in the master database, and signs access tokens.
# Development values are built in; set long random values in production.
# ZIIRA_CREDENTIALS_KEY=
# ZIIRA_SECRET_KEY=

# Development only: X-Tenant-ID header acts as that tenant with every permission
ZIIRA_DEV_TENANT_HEADER=true

# Tests create and drop their own master, template and tenant databases using this connection
ZIIRA_TEST_ADMIN_URL=postgresql+psycopg://ziira:ziira@localhost:5432/postgres

# --- Self-service registration (see docs/registration.md)
# ZIIRA_REGISTRATION_MODE=open            # open | invite | closed
# ZIIRA_REGISTRATION_UNITS=pos,finance,crm,purchasing,people,imports,intel,command    # modules every new business gets
# ZIIRA_PUBLIC_WEB_URL=http://localhost:5173
# ZIIRA_PLATFORM_EMAIL_PROVIDER=          # smtp | brevo | resend | sendgrid (required in production)
# ZIIRA_PLATFORM_EMAIL_SECRET={"api_key": "..."}
# ZIIRA_PLATFORM_EMAIL_CONFIG={"from_address": "no-reply@example.com", "from_name": "Ziira"}

# --- Operations and application security (docs/operations.md) ---
# ZIIRA_METRICS_TOKEN=                    # 24+ random characters; GET /metrics needs "Authorization: Bearer <token>"
# ZIIRA_LOG_FORMAT=json                   # text (default) or json
# ZIIRA_LOG_LEVEL=INFO
# ZIIRA_CORS_ORIGINS=https://app.example.com   # browser origins allowed to call the API; empty = none; never *
# ZIIRA_MAX_BODY_BYTES=2000000
# ZIIRA_STATEMENT_TIMEOUT_MS=60000        # 0 = no limit
# ZIIRA_DB_POOL_SIZE=2                    # per cached tenant database
# ZIIRA_DB_MAX_OVERFLOW=8
# ZIIRA_DB_POOL_TIMEOUT=30
# ZIIRA_MAX_CACHED_TENANT_ENGINES=25
# ZIIRA_PGBOUNCER=false                   # true when connecting through PgBouncer in transaction pooling mode
# Backups: when the local pg_dump is older than the server, run the tools somewhere that matches (e.g. the container):
# ZIIRA_PG_DUMP_COMMAND=docker exec -i -e PGPASSWORD ziira-core-db-1 pg_dump
# ZIIRA_PG_RESTORE_COMMAND=docker exec -i -e PGPASSWORD ziira-core-db-1 pg_restore
# ZIIRA_PG_TOOL_HOST=localhost            # how the tool above reaches PostgreSQL (inside the container)
# ZIIRA_PG_TOOL_PORT=5432
