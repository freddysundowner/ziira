# Copy to .env and adjust.
# Host port for the Docker PostgreSQL (change all 5432s below too if you change it)
ZIIRA_DB_PORT=5432
ZIIRA_ENV=development

# Master database: the list of tenants and how to reach each tenant's own database
ZIIRA_MASTER_DATABASE_URL=postgresql+psycopg://ziira:ziira@localhost:5432/ziira_master
# Server where each tenant's own database is created (a login allowed to create databases and roles)
ZIIRA_TENANT_SERVER_URL=postgresql+psycopg://ziira:ziira@localhost:5432/postgres

# Encrypts tenant database credentials in the master database, and signs access tokens.
# Development values are built in; set long random values in production.
# ZIIRA_CREDENTIALS_KEY=
# ZIIRA_SECRET_KEY=

# Development only: X-Tenant-ID header acts as that tenant with every permission
ZIIRA_DEV_TENANT_HEADER=true

# Tests create and drop their own master, template and tenant databases using this connection
ZIIRA_TEST_ADMIN_URL=postgresql+psycopg://ziira:ziira@localhost:5432/postgres

# --- Self-service registration (see docs/registration.md)
# ZIIRA_REGISTRATION_MODE=open            # open | invite | closed
# ZIIRA_REGISTRATION_UNITS=pos,finance,crm,purchasing,people,imports,intel,command    # modules every new business gets
# ZIIRA_STANDALONE_UNITS=connect,intel,command,imports    # units for a business that only wants Ziira to watch its existing system
# ZIIRA_PUBLIC_WEB_URL=http://localhost:5173
# ZIIRA_PLATFORM_EMAIL_PROVIDER=          # smtp | brevo | resend | sendgrid (required in production)
# ZIIRA_PLATFORM_EMAIL_SECRET={"api_key": "..."}
# ZIIRA_PLATFORM_EMAIL_CONFIG={"from_address": "no-reply@example.com", "from_name": "Ziira"}

# --- Operations and application security (docs/operations.md) ---
# ZIIRA_METRICS_TOKEN=                    # 24+ random characters; GET /metrics needs "Authorization: Bearer <token>"
# ZIIRA_LOG_FORMAT=json                   # text (default) or json
# ZIIRA_LOG_LEVEL=INFO
# ZIIRA_CORS_ORIGINS=https://app.example.com   # browser origins allowed to call the API; empty = none; never *
# ZIIRA_MAX_BODY_BYTES=2000000
# ZIIRA_STATEMENT_TIMEOUT_MS=60000        # 0 = no limit
# ZIIRA_DB_POOL_SIZE=2                    # per cached tenant database
# ZIIRA_DB_MAX_OVERFLOW=8
# ZIIRA_DB_POOL_TIMEOUT=30
# ZIIRA_MAX_CACHED_TENANT_ENGINES=25
# ZIIRA_PGBOUNCER=false                   # true when connecting through PgBouncer in transaction pooling mode
# Backups: when the local pg_dump is older than the server, run the tools somewhere that matches (e.g. the container):
# ZIIRA_PG_DUMP_COMMAND=docker exec -i -e PGPASSWORD ziira-core-db-1 pg_dump
# ZIIRA_PG_RESTORE_COMMAND=docker exec -i -e PGPASSWORD ziira-core-db-1 pg_restore
# ZIIRA_PG_TOOL_HOST=localhost            # how the tool above reaches PostgreSQL (inside the container)
# ZIIRA_PG_TOOL_PORT=5432

# --- AI layer (docs/ai.md): off for every business until its owner consents. The key is a platform secret.
# ZIIRA_AI_PROVIDER=anthropic             # anthropic | fake (development and tests only)
# ZIIRA_AI_API_KEY=
# ZIIRA_AI_MODEL=claude-sonnet-5-5
# ZIIRA_AI_TERMS_CONFIRMED=false          # production: true only after the provider's no-training / retention terms are in place

# Reading scanned statements and photos (self-hosted Tesseract: apt install tesseract-ocr plus language packs)
# ZIIRA_OCR_COMMAND=tesseract
# ZIIRA_OCR_LANGUAGES=eng
# ZIIRA_OCR_MAX_PAGES=30

# --- Third-party plugins, public API and webhooks (docs/plugin-review.md, docs/public-api.md, docs/webhooks.md)
# ZIIRA_EXTRA_UNIT_PATHS=/srv/ziira/plugins        # folders whose sub-folders are third-party plugins (":" separated)
# ZIIRA_ALLOWED_PLUGINS=my_plugin=<sha256>         # production loads an extra plugin only if listed (name=checksum of its reviewed files)
# ZIIRA_API_KEY_RATE_LIMIT_PER_MINUTE=600          # default for keys without their own limit
# ZIIRA_WEBHOOK_MAX_ATTEMPTS=9
# ZIIRA_WEBHOOK_RETRY_HOURS=24
# ZIIRA_WEBHOOK_TIMEOUT_SECONDS=10
# ZIIRA_WEBHOOK_BODY_DAYS=7                        # then only the hash and first bytes of a delivery remain
# ZIIRA_WEBHOOK_LOG_DAYS=90
# ZIIRA_BACKUP_DIR=                      # the folder `ziira backup --dir` writes to: the operator console shows the last backup's age from its manifests
# ZIIRA_OPERATOR_MFA=off                 # Super Admin sign-in: off = email + password only (default), totp = also a code from an authenticator app
# ZIIRA_OPERATOR_MFA_OFF_ACKNOWLEDGED=false  # production refuses to start with OPERATOR_MFA=off unless this is true (docs/security.md: the risk)
# ZIIRA_OPERATOR_MFA_MAX_AGE_MINUTES=10  # console changes need a confirmation (the password, or a code in totp mode) no older than this
# ZIIRA_OPERATOR_SESSION_HOURS=8         # off mode: a Super Admin sign-in ends this long after it began
# ZIIRA_OPERATOR_IDLE_MINUTES=30         # off mode: ... or after this long without a request
# ZIIRA_OPERATOR_ALLOWED_NETWORKS=       # comma separated CIDRs allowed to reach /api/v1/operator (empty: any address); also restrict at the proxy
# ZIIRA_OPERATOR_SIGNIN_EMAILS=false     # email an operator when a sign-in comes from an address not seen before (needs the platform email provider)
# ZIIRA_SITE_ASSISTANT_MONTHLY_CAP_USD=25          # website assistant's fixed protections (docs/operations.md): also _PER_MINUTE=8 _PER_DAY=60 _DAILY_TOTAL=2000 _MAX_OUTPUT_TOKENS=320 _MAX_PARALLEL=8
# ZIIRA_CHAT_PER_SENDER_PER_HOUR=20      # the WhatsApp bot's fixed limits (docs/operations.md): also _CHAT_REPLY_DEADLINE_SECONDS=6 _CHAT_INBOUND_MAX_BYTES=65536; ZIIRA_CHAT_FAKE=1 is development only
# ZIIRA_SITE_DIST_DIR=/var/www/ziira-site         # the site build output; holds assistant-knowledge.json for the website assistant (docs/ai.md section 14)
# ZIIRA_SITE_BUILD_HOOK_URL=               # POSTed (signed) after a website publish so the static site rebuilds; a secret, may hold a token
# ZIIRA_SITE_BUILD_HOOK_SECRET=            # signs that request (Ziira-Signature: v1=HMAC-SHA256 of "{timestamp}.{body}")
# ZIIRA_SITE_PUBLIC_RATE_PER_MINUTE=120    # requests per minute per address to GET /api/v1/public/site

# Plans, subscriptions and licences (docs/platform-admin.md, docs/licensing.md)
# ZIIRA_DEPLOYMENT_MODE=saas                 # or selfhosted
# ZIIRA_DEFAULT_PLAN_CODE=                   # plan a new registration starts a trial on (or set it in Super Admin)
# ZIIRA_LICENCE_PUBLIC_KEY=                  # self-hosted: the vendor's public key (base64)
# ZIIRA_LICENCE_SIGNING_KEY_FILE=            # vendor deployment only: path of the private signing key
# ZIIRA_LICENCE_REQUIRED=false
