---
// The Ziira logo as supplied with the theme: navy letters on light pages, white letters on dark ones (and always in the footer).
interface Props { tone?: "auto" | "dark"; }
const { tone = "auto" } = Astro.props;
---
{tone === "dark"
  ? <img src="/brand/ziira-logo-on-dark.png" alt="" width="224" height="83" decoding="async" />
  : <picture>
      <source media="(prefers-color-scheme: dark)" srcset="/brand/ziira-logo-on-dark.png" />
      <img src="/brand/ziira-logo-on-light.png" alt="" width="224" height="83" decoding="async" />
    </picture>}
