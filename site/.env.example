# Ziira marketing site: build-time settings (copy to .env). Every value is public: nothing secret belongs here.
# Canonical origin of THIS site (no trailing slash). Required for production; unset/placeholder makes the build warn loudly.
PUBLIC_SITE_URL=
# Where the product web app lives (Sign in / Get started links point here).
PUBLIC_APP_URL=http://localhost:5173
# Contact form action (a static form posts here, no JavaScript). If unset, the page shows a notice instead.
PUBLIC_CONTACT_URL=
# Shown as plain text (never a mailto link) when set.
PUBLIC_CONTACT_EMAIL=
# Brand/legal names (placeholders until the owner fills them; later supplied by the platform's Super Admin).
PUBLIC_ORG_NAME=Ziira
PUBLIC_ORG_LEGAL_NAME=
# Comma-separated social profile URLs (Organization sameAs). Leave empty until real profiles exist.
PUBLIC_SOCIAL_URLS=
# Set to true only after a lawyer has reviewed the Privacy and Terms pages: until then they are noindex templates.
PUBLIC_LEGAL_REVIEWED=false
# Set to 1 to make the build FAIL (not just warn) when PUBLIC_SITE_URL is unset or a placeholder.
SITE_STRICT=
# The platform whose Super Admin publishes this site's content (no trailing slash). The build fetches
# {PUBLIC_PLATFORM_API_URL}/api/v1/public/site, keeps a cached copy in .cache/ and copies its pictures to public/media/.
# Unset: the build uses the cached copy or the committed placeholder snapshot (content-snapshot.json) and, in a production
# build, warns loudly (SITE_STRICT=1 makes that a failure).
PUBLIC_PLATFORM_API_URL=
# For CI and tests: read the content from this JSON file instead of the platform.
PLATFORM_SNAPSHOT_FILE=
