{
  "name": "ziira-web",
  "private": true,
  "version": "1.0.0-dev",
  "type": "module",
  "description": "Ziira Core web app: a shell plus pluggable modules that mirror the backend units",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "api": "openapi-typescript ../build/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.62.0",
    "i18next": "23.16.8",
    "lucide-react": "0.468.0",
    "openapi-fetch": "0.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.1.3",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "@testing-library/react": "16.1.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.16.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.13.0",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.4.4",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.16",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.0",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
